# Copie para .env e ajuste. Nunca commite o .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://bastiao:bastiao@localhost:5432/bastiao?schema=public
REDIS_URL=redis://localhost:6379

# JWT da equipe. Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_MFA_SECRET=change-me-mfa-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900

# Sessão da equipe (RQ-27): expira por inatividade e por tempo absoluto
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Criptografia de campo (CPF, celular, segredo TOTP). 32 bytes em base64.
# Gere com: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# Chave do índice cego (busca por CPF/celular sem descriptografar). 32 bytes em base64.
FIELD_HASH_KEY=

# Seed: primeiro usuário dono (só em desenvolvimento)
SEED_OWNER_EMAIL=dono@bastiao.local
SEED_OWNER_PASSWORD=
